{
  "manifest_version": 3,
  "name": "Continue Watching: Resume Any Video",
  "version": "1.0.0",
  "description": "Track video progress on any site and resume where you left off.",
  "permissions": ["storage", "tabs"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Continue Watching",
    "default_popup": "popup.html"
  }
}
